NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Required solely for public intake, never for CRM operations.
SUPABASE_SECRET_KEY=
# Generate with openssl rand -hex 32. Call intake from a trusted website server.
LEAD_INTAKE_SECRET=
# Server only. Enables the reviewed AI lead importer.
OPENAI_API_KEY=
# Optional model override. Defaults to gpt-5.4-mini.
OPENAI_MODEL=gpt-5.4-mini
# Demo is available only in development, unless explicitly enabled here.
ENABLE_DEMO=false
